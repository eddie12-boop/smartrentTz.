# Server Port (Set by hosting provider automatically e.g. Render/Railway)
PORT=5000

# Production Database Connection String (e.g. Railway MySQL, PlanetScale, Aiven, or DigitalOcean)
DATABASE_URL="mysql://user:password@host:3306/smartrent_tz"

# Security Secrets
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"
NODE_ENV="production"

# Frontend Client URL for CORS
CLIENT_URL="https://your-frontend-domain.vercel.app"

# Google Auth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
